    "source": "{-a\\-}\n",
    "html": "<p>{-a-}</p>",
    "roundTrip": false
  },
  {
    "name": "text on both sides",
    "source": "x {*a\\*} y\n",
    "html": "<p>x {*a*} y</p>",
    "roundTrip": false
  },
  {
    "name": "two escaped closers",
    "source": "{*a\\*b\\*}\n",
    "html": "<p>{*a*b*}</p>",
    "roundTrip": false
  },
  {
    "name": "an escaped closer inside a nested kind",
    "source": "{*a{/b\\/}c*}\n",
    "html": "<p><strong>a{/b/}c</strong></p>",
    "roundTrip": false
  },
  {
    "name": "a real closer after the escaped one",
    "source": "{*a\\*}b*}\n",
    "html": "<p><strong>a*}b</strong></p>",
    "roundTrip": false
  },
  {
    "name": "a pair with no escape",
    "source": "{*a*}\n",
    "html": "<p><strong>a</strong></p>",
    "roundTrip": false
  },
  {
    "name": "an escape before an ordinary character",
    "source": "{*a\\b*}\n",
    "html": "<p><strong>a\\b</strong></p>",
    "roundTrip": false
  },
  {
    "name": "an escaped backslash before the closer",
    "source": "{*a\\\\*}\n",
    "html": "<p><strong>a\\</strong></p>",
    "roundTrip": false
  },
  {
    "name": "an escaped opener",
    "source": "{\\*a\\*}\n",
    "html": "<p>{*a*}</p>",
    "roundTrip": false
  },
  {
