        "<!-- carve: ^ Steve Jobs -->"
      ],
      "expectedNodes": [
        {
          "type": "figure",
          "target.type": "block_quote"
        }
      ],
      "aheadOfPin": true
    },
    {
      "id": "table-caption",
      "source": "|= Fruit |= Price |\n| Apple | $1 |\n^ Fruit prices\n",
