  "a_closed_colon_in_a_quoted_item_releases_ownership::hosted_colon_interruption_and_dedent_do_not_keep_stale_claims": [
    {
      "source": "> - item\n>   ::: box\n>   :::\n- tail\n",
      "html": "<blockquote>\n  <ul>\n    <li>item\n      <div class=\"box\">\n\n      </div>\n    </li>\n  </ul>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    },
    {
      "source": "> - item\n>   ::: box\n>   body\n>   :::\n  - tail\n",
      "html": "<blockquote>\n  <ul>\n    <li>item\n      <div class=\"box\">\n        <p>body</p>\n      </div>\n    </li>\n  </ul>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    },
    {
      "source": ">   ::: box\n- tail\n",
      "html": "<blockquote>\n  <div class=\"box\">\n\n  </div>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    },
    {
      "source": "> - ::: box\n>\n> para\n>   :::\n- tail\n",
      "html": "<blockquote>\n  <ul>\n    <li>\n      <div class=\"box\">\n\n      </div>\n    </li>\n  </ul>\n  <p>para</p>\n  <div>\n\n  </div>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    },
    {
      "source": "> - :::box\n>   :::\n- tail\n",
      "html": "<blockquote>\n  <ul>\n    <li>:::box\n      <div>\n\n      </div>\n    </li>\n  </ul>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    },
    {
      "source": "> - paragraph\n>   :::box\n>   :::\n- tail\n",
      "html": "<blockquote>\n  <ul>\n    <li>paragraph\n:::box\n      <div>\n\n      </div>\n    </li>\n  </ul>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    }
  ],
  "a_closed_colon_in_a_quoted_item_releases_ownership::a_new_item_or_later_bare_block_does_not_inherit_absorption": [
    {
      "source": "> - prose\n>   :::bad\n> - next\n>   :::\n- tail\n",
      "html": "<blockquote>\n  <ul>\n    <li>prose\n:::bad</li>\n    <li>next\n      <div>\n\n      </div>\n    </li>\n  </ul>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    },
    {
      "source": "> - ::: box\nlazy\n>   :::\n- tail\n",
      "html": "<blockquote>\n  <ul>\n    <li>\n      <div class=\"box\">\n\n      </div>\n    </li>\n  </ul>\n</blockquote>\n<p>lazy</p>\n<blockquote>\n  <div>\n\n  </div>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    },
    {
      "source": "> - ::: box\n>   body\nlazy\n>   :::\n- tail\n",
      "html": "<blockquote>\n  <ul>\n    <li>\n      <div class=\"box\">\n        <p>body\nlazy</p>\n      </div>\n    </li>\n  </ul>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    }
  ],
  "a_closed_colon_in_a_quoted_item_releases_ownership::dedented_interrupters_end_stale_hosts_and_colon_scopes": [
    {
      "source": "> - item\n> # heading\n>   ::: box\n>   :::\n- tail\n",
      "html": "<blockquote>\n  <ul>\n    <li>item</li>\n  </ul>\n  <h1 id=\"heading\">heading</h1>\n  <div class=\"box\">\n\n  </div>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    },
    {
      "source": "> - ::: box\n>   body\n> # heading\n>   :::\n- tail\n",
      "html": "<blockquote>\n  <ul>\n    <li>\n      <div class=\"box\">\n        <p>body</p>\n      </div>\n    </li>\n  </ul>\n  <h1 id=\"heading\">heading</h1>\n  <div>\n\n  </div>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    }
  ],
  "a_closed_colon_in_a_quoted_item_releases_ownership::a_closed_hosted_comment_ends_the_paragraph_before_quoted_dedent": [
    {
      "source": "> - ::: box\n>   text\n>   %%%\n>   c\n>   %%%\n> out\n>   :::\n- tail\n",
      "html": "<blockquote>\n  <ul>\n    <li>\n      <div class=\"box\">\n        <p>text</p>\n      </div>\n    </li>\n  </ul>\n  <p>out</p>\n  <div>\n\n  </div>\n</blockquote>\n<ul>\n  <li>tail</li>\n</ul>"
    }
  ],
  "new_quote_definition_opacity::folded_marker_definition_collection_preserves_preceding_items": [
    {
      "source": "> - a\n>  - x\n>   - b\n> - c\n>  - ```\n> [r]: /t\n> ```\n\n[x][r]\n",
      "html": "<blockquote>\n  <ul>\n    <li>a</li>\n    <li>x</li>\n    <li>b</li>\n    <li>c</li>\n    <li>\n      <pre><code></code></pre>\n    </li>\n  </ul>\n  <pre><code></code></pre>\n</blockquote>\n<p><a href=\"/t\">x</a></p>"
    }
  ]
