      "html": "<p>:  &gt; :: t</p>\n<blockquote>\n  <pre><code>[r]: /u\n[^a]: note\n</code></pre>\n</blockquote>"
    }
  ],
  "definition_term_separator_space::indented_description_quotes_stay_literal_term_content": [
    {
      "source": ":: t\n  :  > [^a]: note\n",
      "html": "<dl>\n  <dt>t</dt>\n  <dd>\n    <blockquote>\n\n    </blockquote>\n  </dd>\n</dl>"
    },
    {
      "source": "> :: t\n>   :  > [^a]: note\n",
      "html": "<blockquote>\n  <dl>\n    <dt>t</dt>\n    <dd>\n      <blockquote>\n\n      </blockquote>\n    </dd>\n  </dl>\n</blockquote>"
    },
    {
      "source": "- :: t\n    :  > [^a]: note\n",
      "html": "<ul>\n  <li>\n    <dl>\n      <dt>t</dt>\n      <dd>\n        <blockquote>\n\n        </blockquote>\n      </dd>\n    </dl>\n  </li>\n</ul>"
    },
    {
      "source": ": > :: t\n> ```\n> [^a]: note\n",
      "html": "<p>: &gt; :: t</p>\n<blockquote>\n  <pre><code>[^a]: note\n</code></pre>\n</blockquote>"
    }
  ],
  "definition_term_separator_space::indented_term_text_does_not_own_a_fence_past_a_paragraph_break": [
    {
      "source": " :: t\n ```\n\n - a\n   [^a]: note\n\nsee [^a]\n",
      "html": "<dl>\n  <dt>t</dt>\n</dl>\n<pre><code>\n- a\n  [^a]: note\n\nsee [^a]\n</code></pre>"
    },
    {
      "source": "  :: t\n  ```\n\n  - a\n    [^a]: note\n\nsee [^a]\n",
      "html": "<dl>\n  <dt>t</dt>\n</dl>\n<pre><code>\n- a\n  [^a]: note\n\nsee [^a]\n</code></pre>"
    },
    {
      "source": "    :: t\n    ```\n\n    - a\n      [^a]: note\n\nsee [^a]\n",
      "html": "<dl>\n  <dt>t</dt>\n</dl>\n<pre><code>\n- a\n  [^a]: note\n\nsee [^a]\n</code></pre>"
    }
  ],
  "definition_term_separator_space::collected_definitions_allow_following_list_terms_to_own_fences": [
    {
      "source": "[r]: /u\n- :: t\n  ```\n  [x]: /v\n",
