      "html": "<ul>\n  <li>\n    <dl>\n      <dt>a</dt>\n    </dl>\n    <pre><code>c\n</code></pre>\n  </li>\n  <li>para</li>\n  <li>\n    <dl>\n      <dt>t</dt>\n    </dl>\n    <pre><code>\n- y\n  [^a]: note\n\n</code></pre>\n  </li>\n</ul>\n<p>see [^a]</p>"
