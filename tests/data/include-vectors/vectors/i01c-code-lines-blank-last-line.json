          "startColumn": 1,
          "endLine": 3,
          "endColumn": 1,
          "startOffset": 0,
          "endOffset": 3,
          "file": "t.txt"
        }
      },
      {
        "type": "code_block",
        "pos": {
          "startLine": 1,
          "startColumn": 1,
          "endLine": 3,
          "endColumn": 1,
          "startOffset": 0,
          "endOffset": 3,
          "file": "t.txt"
        }
      }
    ]
  },
  "entry": "{{ t.txt @code }}\n\n{{ t.txt @lines:1-3 @code }}\n",
  "files": {
    "t.txt": "x\n\n\n"
  }
