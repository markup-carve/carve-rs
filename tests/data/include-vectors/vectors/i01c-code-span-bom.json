{
  "name": "i01c-code-span-bom",
  "description": "A leading BOM shifts the first code span start for whole-file and line selection.",
  "verdict": "changed",
  "clauses": [
    "C2-N-019",
    "C2-N-044",
    "C2-A-141"
  ],
  "resolver": "virtual",
  "expected": {
    "html": "<pre><code>ab\ncd\n</code></pre>\n<pre><code>ab\n</code></pre>",
    "fmt": "{{ b.txt @code }}\n\n{{ b.txt @lines:1-1 @code }}\n",
    "warnings": [],
    "dependencies": [
      {
        "id": "b.txt",
        "read": true
      }
    ],
    "positions": [
      {
        "type": "code_block",
        "pos": {
          "startLine": 1,
          "startColumn": 1,
          "endLine": 2,
          "endColumn": 3,
          "startOffset": 3,
          "endOffset": 8,
          "file": "b.txt"
        }
      },
      {
        "type": "code_block",
        "pos": {
          "startLine": 1,
          "startColumn": 1,
          "endLine": 1,
          "endColumn": 3,
          "startOffset": 3,
          "endOffset": 5,
          "file": "b.txt"
        }
      }
    ]
  },
  "note": "positions: 0.2 offsets count UTF-8 bytes (C2-A-141), so the U+FEFF moves `startOffset` from 1 to 3 (C2-N-019, C2-N-044)",
  "entry": "{{ b.txt @code }}\n\n{{ b.txt @lines:1-1 @code }}\n",
  "files": {
    "b.txt": "﻿ab\ncd\n"
  }
}
